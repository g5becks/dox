# Exit code 130 (interrupted) on SIGINT during sync saves completed sources' lock entries.
doxinterrupt 130 sync --json
exists .dox/fast/fast.txt .dox/.dox.lock
grep '"fast"' .dox/.dox.lock
! grep '"slow"' .dox/.dox.lock
jsoncmp interrupt.stderr want-interrupt.json

-- want-interrupt.json --
{
  "error": {
    "code": "interrupted",
    "message": "sync interrupted: context canceled",
    "hint": "",
    "fields": {
      "failed_sources": 1,
      "legacy_code": "DOWNLOAD_FAILED"
    }
  }
}

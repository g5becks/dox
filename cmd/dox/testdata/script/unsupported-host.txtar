# Unsupported providers fail config validation with exit 2 before any network
# request (audit C4, dox-deb.17). GitHub Enterprise, GitLab and Gitea
# (Forgejo, Codeberg) are supported since v0.5.0; an unknown host without an
# explicit type is still rejected rather than queried as GitHub.
dox list --config gitlab-host.toml
stdout 'docs'
dox list --config codeberg-host.toml
stdout 'docs'
dox list --config enterprise-host.toml
stdout 'docs'
dox list --config gitlab-type.toml
stdout 'docs'

doxexit 2 sync --config unknown-host.toml
stderr 'source type "git" \(host "git.mycorp.com"\) for source "docs" is not supported yet \(planned for v0.5.0\)'
stderr '^hint: Set type to github \(github.com or Enterprise\), gitlab or gitea'

doxexit 2 list --config unknown-host.toml
stderr 'not supported yet'

-- gitlab-host.toml --
[sources.docs]
repo = "acme/docs"
path = "docs"
host = "gitlab.com"
-- codeberg-host.toml --
[sources.docs]
repo = "acme/docs"
path = "docs"
host = "codeberg.org"
-- enterprise-host.toml --
[sources.docs]
repo = "acme/docs"
path = "docs"
host = "github.mycorp.com"
-- unknown-host.toml --
[sources.docs]
repo = "acme/docs"
path = "docs"
host = "git.mycorp.com"
-- gitlab-type.toml --
[sources.docs]
type = "gitlab"
repo = "acme/docs"
path = "docs"

httpserve guide.txt
envsubst config.in dox.toml
dox sync
exists .dox/.dox.lock .dox/manifest.json
cmp .dox/docs/guide.txt guide.txt
dox cat docs guide.txt --limit 1
stdout 'Documentation fixture'

-- config.in --
output = ".dox"
[sources.docs]
type = "url"
url = "$SERVER/guide.txt"
filename = "guide.txt"
-- guide.txt --
Documentation fixture
Second line
